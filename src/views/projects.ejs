<%- include('partials/header') %>
<main class="container">
    <h1><%= title %></h1>
    <h2>Upcoming Service Projects</h2>
    
    <% if (typeof projects !== 'undefined' && projects.length > 0) { %>
        <ul class="project-list">
            <% projects.forEach((project) => { %>
                <li>
                    <strong><%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>: <%= project.title %> (<%= project.organization_name %>)</strong><br>
                    <span><%= project.description %> - <%= project.location %></span>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>No service projects found.</p>
    <% } %>
</main>
<%- include('partials/footer') %>