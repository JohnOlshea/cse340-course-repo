<%- include('partials/header') %>
<main class="container">
    <h1><%= title %></h1>

    <% if (typeof projects !== 'undefined' && projects.length > 0) { %>
        <ul class="project-list">
            <% projects.forEach((project) => { %>
                <li>
                    <strong><%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>:
                    <a href="/project/<%= project.project_id %>"><%= project.title %></a>
                    (<a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>)</strong><br>
                    <span><%= project.description %> - <%= project.location %></span>
                </li>
            <% }) %>
        </ul>
    <% } else { %>
        <p>No upcoming service projects found.</p>
    <% } %>
</main>
<%- include('partials/footer') %>