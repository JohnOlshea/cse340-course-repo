<%- include('partials/header') %>
<main class="container">
    <h1><%= title %></h1>
    <p>Here are a few of our partner organizations:</p>
    <ul class="org-list">
        <% organizations.forEach(organization => { %>
            <li><img src="/images/<%= organization.logo_filename %>" alt="<%= organization.name %> logo"><div><strong><%= organization.name %></strong><br><%= organization.contact_email %></div></li>
        <% }); %>
    </ul>
</main>
<%- include('partials/footer') %>