<%- include('partials/header') %>
<main class="container">
    <h1><%= title %></h1>

    <h2><%= project.title %></h2>
    <p><%= project.description %></p>
    <p><strong>Date:</strong> <%= new Date(project.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></p>
    <p><strong>Location:</strong> <%= project.location %></p>
    <p><strong>Organization:</strong> <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a></p>

    <% if (typeof categories !== 'undefined' && categories.length > 0) { %>
        <p><strong>Categories:</strong>
            <% categories.forEach((category) => { %>
                <a class="category-tag" href="/category/<%= category.category_id %>"><%= category.name %></a>
            <% }) %>
        </p>
    <% } %>

    <p><a href="/projects">← Back to Upcoming Projects</a></p>
</main>
<%- include('partials/footer') %>