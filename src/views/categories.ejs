<%- include('partials/header') %>
<main class="container">
    <h1><%= title %></h1>
    <p>Browse service projects by category:</p>
    
    <div class="category-grid">
        <% categories.forEach((category) => { %>
            <div class="category-card">
                <h3><%= category.name %></h3>
                <p>Explore <%= category.name.toLowerCase() %> service opportunities in your community.</p>
            </div>
        <% }) %>
    </div>
</main>
<%- include('partials/footer') %>